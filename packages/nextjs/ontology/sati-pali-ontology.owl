  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path">
    <dct:title xml:lang="en">Satipatthana: The Direct Path to Realization</dct:title>
    <dct:type xml:lang="en">Book</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.buddhismuskunde.uni-hamburg.de/pdf/5-personen/analayo/direct-path.pdf"/>
    <rdfs:comment xml:lang="en">Bhikkhu Anālayo’s commentary, offered as a free PDF by the University of Hamburg. The book remains his copyright, so its prose is not copied here. The terms below are the public-domain satipaṭṭhāna map the book explains.</rdfs:comment>
  </dct:BibliographicResource>
  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-analayo-practice-guide">
    <dct:title xml:lang="en">Early Buddhist Satipaṭṭhāna Meditation: A Practice Guide</dct:title>
    <dct:type xml:lang="en">Book</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.buddhismuskunde.uni-hamburg.de/pdf/5-personen/analayo/satipatthanapracticeguide.pdf"/>
    <rdfs:comment xml:lang="en">Anālayo’s practice companion to the same four foundations, also a free PDF from Hamburg, and also not copied into these glosses.</rdfs:comment>
  </dct:BibliographicResource>
  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion">
    <dct:title xml:lang="en">Compassion and Emptiness in Early Buddhist Meditation</dct:title>
    <dct:type xml:lang="en">Book</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.buddhismuskunde.uni-hamburg.de/pdf/5-personen/analayo/compassionemptiness.pdf"/>
    <rdfs:comment xml:lang="en">Anālayo on karuṇā and suññatā in the early texts. The PDF is free to read; the glossary keeps its own short glosses.</rdfs:comment>
  </dct:BibliographicResource>
  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-varela-science-religion-art">
    <dct:title xml:lang="en">Francisco Varela on Science, Religion and Art</dct:title>
    <dct:type xml:lang="en">Talk</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.youtube.com/watch?v=vgZMPcrRmio"/>
    <rdfs:comment xml:lang="en">A contemporary talk, not a Pāli text. It sits beside the body and mindfulness, where practice meets embodied cognition.</rdfs:comment>
  </dct:BibliographicResource>
  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-salzberg-openness">
    <dct:title xml:lang="en">Sharon Salzberg: The Journey from Isolation to Openness</dct:title>
    <dct:type xml:lang="en">Talk</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.youtube.com/watch?v=wu9A1YHLU5Q&amp;t=298"/>
    <rdfs:comment xml:lang="en">A talk on goodwill and opening the heart. The Pāli term it bears on is mettā.</rdfs:comment>
  </dct:BibliographicResource>
  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-analayo-traditions">
    <dct:title xml:lang="en">Bhikkhu Anālayo: Respecting Different Buddhist Traditions</dct:title>
    <dct:type xml:lang="en">Talk</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.youtube.com/watch?v=cd8zAVltf4s"/>
    <rdfs:comment xml:lang="en">A conversation about staying with the early teaching while respecting other Buddhist traditions.</rdfs:comment>
  </dct:BibliographicResource>
  <dct:BibliographicResource rdf:about="https://marlonbarrios.github.io/sati-ontology#source-lions-roar-sati">
    <dct:title xml:lang="en">Lion's Roar: Meet Sati-AI</dct:title>
    <dct:type xml:lang="en">Article</dct:type>
    <rdfs:seeAlso rdf:resource="https://www.lionsroar.com/ai-meditation-teacher/"/>
    <rdfs:comment xml:lang="en">A magazine piece about this project. It is an article, not a canonical source, and it points back to sati.</rdfs:comment>
  </dct:BibliographicResource>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#tilakkhana">
    <skos:prefLabel xml:lang="pi">tilakkhaṇa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three marks</skos:prefLabel>
    <skos:definition xml:lang="en">The three characteristics of conditioned experience: impermanence, unsatisfactoriness, and not-self. Seeing them clearly is the heart of insight.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-marks"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">three marks</skos:altLabel>
    <skos:altLabel xml:lang="en">three characteristics</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anicca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dukkha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anatta"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#anicca">
    <skos:prefLabel xml:lang="pi">anicca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impermanence</skos:prefLabel>
    <skos:definition xml:lang="en">Whatever arises changes and ceases. Nothing conditioned stays fixed.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-marks"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">impermanence</skos:altLabel>
    <skos:altLabel xml:lang="en">impermanent</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tilakkhana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dukkha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anatta"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dukkha">
    <skos:prefLabel xml:lang="pi">dukkha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unsatisfactoriness</skos:prefLabel>
    <skos:definition xml:lang="en">The strain of experience that cannot finally satisfy: pain, change, and the burden of conditioned life. It is the first noble truth, not a claim that every moment feels miserable.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-marks"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">suffering</skos:altLabel>
    <skos:altLabel xml:lang="en">unsatisfactoriness</skos:altLabel>
    <skos:altLabel xml:lang="en">stress</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tilakkhana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#ariyasacca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#anatta">
    <skos:prefLabel xml:lang="pi">anattā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">not-self</skos:prefLabel>
    <skos:definition xml:lang="en">No experience, body, or mind contains a permanent owner. What is seen as 'me' or 'mine' is a changing process.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-marks"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">not-self</skos:altLabel>
    <skos:altLabel xml:lang="en">non-self</skos:altLabel>
    <skos:altLabel xml:lang="en">no self</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tilakkhana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pancakkhandha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sunnata"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#ariyasacca">
    <skos:prefLabel xml:lang="pi">cattāri ariyasaccāni</skos:prefLabel>
    <skos:prefLabel xml:lang="en">four noble truths</skos:prefLabel>
    <skos:definition xml:lang="en">The framework of the teaching: unsatisfactoriness, its origin, its cessation, and the path to cessation. Each truth has a task: understand, abandon, realize, develop.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">four noble truths</skos:altLabel>
    <skos:altLabel xml:lang="en">noble truths</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dukkha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samudaya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nirodha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#magga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#samudaya">
    <skos:prefLabel xml:lang="pi">dukkhasamudaya</skos:prefLabel>
    <skos:prefLabel xml:lang="en">origin of unsatisfactoriness</skos:prefLabel>
    <skos:definition xml:lang="en">The second truth. Craving produces the repeating stress of conditioned life.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">origin</skos:altLabel>
    <skos:altLabel xml:lang="en">craving</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#ariyasacca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#nirodha">
    <skos:prefLabel xml:lang="pi">dukkhanirodha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cessation</skos:prefLabel>
    <skos:definition xml:lang="en">The third truth. Unsatisfactoriness ends when craving ends. That end is nibbāna.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">cessation</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#ariyasacca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#magga">
    <skos:prefLabel xml:lang="pi">magga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">path</skos:prefLabel>
    <skos:definition xml:lang="en">The fourth truth: the way of practice that leads to cessation, spelled out as the noble eightfold path.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">the path</skos:altLabel>
    <skos:altLabel xml:lang="en">eightfold path</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#atthangikamagga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#ariyasacca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#tanha">
    <skos:prefLabel xml:lang="pi">taṇhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">craving</skos:prefLabel>
    <skos:definition xml:lang="en">Thirst for sense pleasure, for becoming, or for getting rid of what is painful. It is named as the origin in the second truth.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">craving</skos:altLabel>
    <skos:altLabel xml:lang="en">thirst</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samudaya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#upadana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamatanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bhavatanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vibhavatanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nirodha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kamatanha">
    <skos:prefLabel xml:lang="pi">kāmataṇhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">craving for sensual pleasure</skos:prefLabel>
    <skos:definition xml:lang="en">Thirst for pleasant sights, sounds, smells, tastes, touches, and ideas. One of the three kinds of taṇhā.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">sensual craving</skos:altLabel>
    <skos:altLabel xml:lang="en">craving for sense pleasure</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamacchanda"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bhavatanha">
    <skos:prefLabel xml:lang="pi">bhavataṇhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">craving for becoming</skos:prefLabel>
    <skos:definition xml:lang="en">Thirst to continue, to be a particular kind of being, or to arrive at a particular state.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">craving for existence</skos:altLabel>
    <skos:altLabel xml:lang="en">craving to become</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bhava"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vibhavatanha">
    <skos:prefLabel xml:lang="pi">vibhavataṇhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">craving for non-becoming</skos:prefLabel>
    <skos:definition xml:lang="en">Thirst to be rid of what is painful, or for a painful state to stop. It is still craving.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-four-noble-truths"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">craving for annihilation</skos:altLabel>
    <skos:altLabel xml:lang="en">craving to get rid of</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nirodha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#atthangikamagga">
    <skos:prefLabel xml:lang="pi">ariyo aṭṭhaṅgiko maggo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">noble eightfold path</skos:prefLabel>
    <skos:definition xml:lang="en">Right view, intention, speech, action, livelihood, effort, mindfulness, and collectedness. Together they are the path truth.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">eightfold path</skos:altLabel>
    <skos:altLabel xml:lang="en">noble eightfold path</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammaditthi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammasankappa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammavaca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammakammanta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammaajiva"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammavayama"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammasati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammasamadhi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammaditthi">
    <skos:prefLabel xml:lang="pi">sammādiṭṭhi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right view</skos:prefLabel>
    <skos:definition xml:lang="en">Seeing experience in the light of the four truths, kamma, and not-self, rather than through a fixed identity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right view</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#atthangikamagga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammasankappa">
    <skos:prefLabel xml:lang="pi">sammāsaṅkappa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right intention</skos:prefLabel>
    <skos:definition xml:lang="en">Intention of letting go, of goodwill, and of non-harming.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right intention</skos:altLabel>
    <skos:altLabel xml:lang="en">right thought</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#atthangikamagga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammavaca">
    <skos:prefLabel xml:lang="pi">sammāvācā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right speech</skos:prefLabel>
    <skos:definition xml:lang="en">Speech that abstains from lying, harshness, division, and idle chatter.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right speech</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sila"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammakammanta">
    <skos:prefLabel xml:lang="pi">sammākammanta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right action</skos:prefLabel>
    <skos:definition xml:lang="en">Bodily conduct that abstains from killing, taking what is not given, and sexual harm.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right action</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sila"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammaajiva">
    <skos:prefLabel xml:lang="pi">sammāājīva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right livelihood</skos:prefLabel>
    <skos:definition xml:lang="en">Supporting one's life in a way that does not require harm.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right livelihood</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sila"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammavayama">
    <skos:prefLabel xml:lang="pi">sammāvāyāma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right effort</skos:prefLabel>
    <skos:definition xml:lang="en">Energy that prevents and abandons unwholesome states and arouses and maintains wholesome ones.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right effort</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammappadhana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viriya"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammasati">
    <skos:prefLabel xml:lang="pi">sammāsati</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right mindfulness</skos:prefLabel>
    <skos:definition xml:lang="en">Remembering to attend, clearly, to body, feeling, mind, and patterns of experience.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right mindfulness</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#satipatthana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammasamadhi">
    <skos:prefLabel xml:lang="pi">sammāsamādhi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right collectedness</skos:prefLabel>
    <skos:definition xml:lang="en">A mind gathered, steady, and bright enough for insight. Classically described through the four jhānas.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">right concentration</skos:altLabel>
    <skos:altLabel xml:lang="en">right collectedness</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#jhana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#jhana">
    <skos:prefLabel xml:lang="pi">jhāna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">absorption</skos:prefLabel>
    <skos:definition xml:lang="en">Deep states of unified attention. They steady the mind; they are not themselves the goal.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-eightfold-path"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">absorption</skos:altLabel>
    <skos:altLabel xml:lang="en">jhana</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammasamadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samatha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#tisikkha">
    <skos:prefLabel xml:lang="pi">tisikkhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three trainings</skos:prefLabel>
    <skos:definition xml:lang="en">The path gathered into ethics, collectedness, and wisdom. Each supports the others.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-trainings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">three trainings</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sila"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sila">
    <skos:prefLabel xml:lang="pi">sīla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ethics</skos:prefLabel>
    <skos:definition xml:lang="en">Care in speech, action, and livelihood so that the mind is less tangled by harm.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-trainings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">ethics</skos:altLabel>
    <skos:altLabel xml:lang="en">virtue</skos:altLabel>
    <skos:altLabel xml:lang="en">precepts</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tisikkha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammavaca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#samadhi">
    <skos:prefLabel xml:lang="pi">samādhi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">collectedness</skos:prefLabel>
    <skos:definition xml:lang="en">The mind gathered around a wholesome object, neither scattered nor forced.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-trainings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">concentration</skos:altLabel>
    <skos:altLabel xml:lang="en">collectedness</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammasamadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samatha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#panna">
    <skos:prefLabel xml:lang="pi">paññā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wisdom</skos:prefLabel>
    <skos:definition xml:lang="en">Direct understanding of impermanence, unsatisfactoriness, and not-self, not only an idea about them.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-three-trainings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">wisdom</skos:altLabel>
    <skos:altLabel xml:lang="en">discernment</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vipassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammaditthi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#paticcasamuppada">
    <skos:prefLabel xml:lang="pi">paṭiccasamuppāda</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dependent origination</skos:prefLabel>
    <skos:definition xml:lang="en">Nothing arises alone. From not-knowing through feeling, craving, clinging, and becoming, birth and aging-and-death keep turning. When a link is no longer fed, the pattern can cease.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">dependent origination</skos:altLabel>
    <skos:altLabel xml:lang="en">dependent arising</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#avijja"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vedana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#avijja">
    <skos:prefLabel xml:lang="pi">avijjā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">not-knowing</skos:prefLabel>
    <skos:definition xml:lang="en">Not seeing the four truths. It is the first link of dependent origination and the last of the ten fetters.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">ignorance</skos:altLabel>
    <skos:altLabel xml:lang="en">not-knowing</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#paticcasamuppada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#moha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sankhara">
    <skos:prefLabel xml:lang="pi">saṅkhāra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">formations</skos:prefLabel>
    <skos:definition xml:lang="en">Constructing activities: intentions that shape experience, and, as an aggregate, the mental activities other than feeling and perception.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">formations</skos:altLabel>
    <skos:altLabel xml:lang="en">volitional formations</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pancakkhandha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamma"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vinnana">
    <skos:prefLabel xml:lang="pi">viññāṇa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">consciousness</skos:prefLabel>
    <skos:definition xml:lang="en">Knowing through a sense door: seeing, hearing, smelling, tasting, touching, or thinking. It arises with an object; it is not a lasting self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">consciousness</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pancakkhandha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#namarupa">
    <skos:prefLabel xml:lang="pi">nāmarūpa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">name-and-form</skos:prefLabel>
    <skos:definition xml:lang="en">Mentality and materiality together: the felt, named side of experience and the bodily side, dependent on each other.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">name and form</skos:altLabel>
    <skos:altLabel xml:lang="en">name-and-form</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#rupa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#paticcasamuppada"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#salayatana">
    <skos:prefLabel xml:lang="pi">saḷāyatana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">six sense bases</skos:prefLabel>
    <skos:definition xml:lang="en">Eye, ear, nose, tongue, body, and mind, meeting their objects: sights, sounds, smells, tastes, touches, and mental phenomena.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">six sense bases</skos:altLabel>
    <skos:altLabel xml:lang="en">sense bases</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#phassa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#cakkhu"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#mano"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#phassa">
    <skos:prefLabel xml:lang="pi">phassa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contact</skos:prefLabel>
    <skos:definition xml:lang="en">The meeting of a sense base, its object, and the knowing of that meeting. Feeling is born from contact.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">contact</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vedana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vedana">
    <skos:prefLabel xml:lang="pi">vedanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">feeling tone</skos:prefLabel>
    <skos:definition xml:lang="en">The pleasant, painful, or neither-pleasant-nor-painful tone of experience. It is not the story about the feeling.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-five-aggregates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">feeling</skos:altLabel>
    <skos:altLabel xml:lang="en">feeling tone</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vedananupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sukha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dukkha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#upadana">
    <skos:prefLabel xml:lang="pi">upādāna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clinging</skos:prefLabel>
    <skos:definition xml:lang="en">Holding on: to sense pleasure, to views, to rites and habits as if they were the path, and to a doctrine of self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">clinging</skos:altLabel>
    <skos:altLabel xml:lang="en">grasping</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bhava"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bhava">
    <skos:prefLabel xml:lang="pi">bhava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">becoming</skos:prefLabel>
    <skos:definition xml:lang="en">The momentum of a life taking shape from clinging: a way of being that is already leaning toward the next birth of that pattern.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">becoming</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#upadana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#jati"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#jati">
    <skos:prefLabel xml:lang="pi">jāti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">birth</skos:prefLabel>
    <skos:definition xml:lang="en">The appearing of a new identity in a world of experience, whether read as rebirth or as the birth of a self-story.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">birth</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bhava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#jaramarana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#jaramarana">
    <skos:prefLabel xml:lang="pi">jarāmaraṇa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aging-and-death</skos:prefLabel>
    <skos:definition xml:lang="en">The ending built into whatever is born: aging, falling apart, grief, and death.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-dependent-origination"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">aging and death</skos:altLabel>
    <skos:altLabel xml:lang="en">death</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#jati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anicca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#pancakkhandha">
    <skos:prefLabel xml:lang="pi">pañcakkhandhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">five aggregates</skos:prefLabel>
    <skos:definition xml:lang="en">A person, looked at without a hidden owner: form, feeling, perception, formations, and consciousness.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-five-aggregates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">five aggregates</skos:altLabel>
    <skos:altLabel xml:lang="en">aggregates</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#rupa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vedana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sanna"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sankhara"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vinnana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anatta"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#rupa">
    <skos:prefLabel xml:lang="pi">rūpa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">form</skos:prefLabel>
    <skos:definition xml:lang="en">The bodily, material side of experience, including the body as sensed. As an aggregate it is not the self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-five-aggregates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">form</skos:altLabel>
    <skos:altLabel xml:lang="en">materiality</skos:altLabel>
    <skos:altLabel xml:lang="en">body</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pancakkhandha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sanna">
    <skos:prefLabel xml:lang="pi">saññā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">perception</skos:prefLabel>
    <skos:definition xml:lang="en">Recognizing and labeling: the mind marking an experience as this or that.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-five-aggregates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">perception</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pancakkhandha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#cakkhu">
    <skos:prefLabel xml:lang="pi">cakkhu</skos:prefLabel>
    <skos:prefLabel xml:lang="en">eye</skos:prefLabel>
    <skos:definition xml:lang="en">The eye base. With a sight and eye-consciousness, visual contact occurs.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">eye</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sota">
    <skos:prefLabel xml:lang="pi">sota</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ear</skos:prefLabel>
    <skos:definition xml:lang="en">The ear base, the door of hearing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">ear</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#ghana">
    <skos:prefLabel xml:lang="pi">ghāna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nose</skos:prefLabel>
    <skos:definition xml:lang="en">The nose base, the door of smell.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">nose</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
