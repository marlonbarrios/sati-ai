  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sati">
    <skos:prefLabel xml:lang="pi">sati</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mindfulness</skos:prefLabel>
    <skos:definition xml:lang="en">Remembering. In practice, remembering to be present with what is actually happening, and remembering the teaching while you do.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mindfulness</skos:altLabel>
    <skos:altLabel xml:lang="en">remembering</skos:altLabel>
