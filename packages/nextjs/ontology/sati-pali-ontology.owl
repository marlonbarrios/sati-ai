    <skos:prefLabel xml:lang="pi">satipaṭṭhāna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foundations of mindfulness</skos:prefLabel>
    <skos:definition xml:lang="en">Four fields for remembering to look: body, feeling tone, mind, and patterns of experience.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
