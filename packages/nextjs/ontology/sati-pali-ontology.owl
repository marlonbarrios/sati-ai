  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sampajanna">
    <skos:prefLabel xml:lang="pi">sampajañña</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clear comprehension</skos:prefLabel>
    <skos:definition xml:lang="en">Knowing what one is doing while doing it: purpose, suitability, and the field of experience one is in.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
