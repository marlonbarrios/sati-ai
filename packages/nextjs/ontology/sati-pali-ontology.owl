  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#anapanasati">
    <skos:prefLabel xml:lang="pi">ānāpānasati</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mindfulness of breathing</skos:prefLabel>
    <skos:definition xml:lang="en">Using the breath as the anchor for mindfulness, and through it for the body, feeling, mind, and wisdom.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mindfulness of breathing</skos:altLabel>
    <skos:altLabel xml:lang="en">anapanasati</skos:altLabel>
    <skos:altLabel xml:lang="en">breath</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
