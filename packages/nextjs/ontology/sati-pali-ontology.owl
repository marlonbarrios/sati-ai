         xmlns:dct="http://purl.org/dc/terms/">
  <owl:Ontology rdf:about="https://marlonbarrios.github.io/sati-ontology">
    <rdfs:label xml:lang="en">Sati Pali Ontology</rdfs:label>
    <dct:description xml:lang="en">This ontology follows the public-domain early Buddhist lists preserved in the Pāli Tipiṭaka: the three marks, the four noble truths (SN 56.11), the noble eightfold path (SN 45.8), dependent origination (SN 12.2), the aggregates (SN 22), the sense bases (SN 35), satipaṭṭhāna (MN 10, DN 22), and the thirty-seven bodhipakkhiyā dhammā. The four paramattha dhammas are the later Theravada Abhidhamma division of that same field. The English glosses were written for Sati-AI. They are not copied from a copyrighted dictionary.</dct:description>
    <dct:creator xml:lang="en">Marlon Barrios Solano</dct:creator>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </owl:Ontology>
