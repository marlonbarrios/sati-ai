    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#karuna"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#mudita"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#upekkha"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-salzberg-openness"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#metta">
    <skos:prefLabel xml:lang="pi">mettā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">goodwill</skos:prefLabel>
    <skos:definition xml:lang="en">The wish that beings be well, without needing them to be yours.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-divine-abidings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">loving-kindness</skos:altLabel>
    <skos:altLabel xml:lang="en">goodwill</skos:altLabel>
    <skos:altLabel xml:lang="en">metta</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#brahmavihara"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-salzberg-openness"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#karuna">
    <skos:prefLabel xml:lang="pi">karuṇā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">compassion</skos:prefLabel>
    <skos:definition xml:lang="en">The tremble of the heart that wants suffering to ease, in oneself and in others.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-divine-abidings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">compassion</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#brahmavihara"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dukkha"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#mudita">
    <skos:prefLabel xml:lang="pi">muditā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">joy in others' good</skos:prefLabel>
    <skos:definition xml:lang="en">Gladness when another being is happy or free. It is the antidote to envy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-divine-abidings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">sympathetic joy</skos:altLabel>
    <skos:altLabel xml:lang="en">mudita</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#brahmavihara"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#upekkha">
    <skos:prefLabel xml:lang="pi">upekkhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">equanimity</skos:prefLabel>
    <skos:definition xml:lang="en">Balance that does not lean into grabbing or pushing away. It is the fourth divine abiding, and also an awakening factor.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-divine-abidings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">upekkha</skos:altLabel>
    <skos:altLabel xml:lang="en">upeka</skos:altLabel>
    <skos:altLabel xml:lang="en">equipoise</skos:altLabel>
    <skos:altLabel xml:lang="en">equanimity</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#brahmavihara"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#metta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#karuna"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#mudita"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sotapanna">
    <skos:prefLabel xml:lang="pi">sotāpanna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stream-enterer</skos:prefLabel>
    <skos:definition xml:lang="en">A person who has seen the truths directly and dropped identity view, doubt, and attachment to rites.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">stream-enterer</skos:altLabel>
    <skos:altLabel xml:lang="en">stream entry</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sakkayaditthi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vicikiccha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#silabbataparamasa"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sakadagami">
    <skos:prefLabel xml:lang="pi">sakadāgāmī</skos:prefLabel>
    <skos:prefLabel xml:lang="en">once-returner</skos:prefLabel>
    <skos:definition xml:lang="en">A person in whom sensual lust and aversion have been weakened.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">once-returner</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sotapanna"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anagami"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#anagami">
    <skos:prefLabel xml:lang="pi">anāgāmī</skos:prefLabel>
    <skos:prefLabel xml:lang="en">non-returner</skos:prefLabel>
    <skos:definition xml:lang="en">A person who has abandoned sensual lust and aversion.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">non-returner</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamaraga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#patigha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#arahant">
    <skos:prefLabel xml:lang="pi">arahant</skos:prefLabel>
    <skos:prefLabel xml:lang="en">worthy one</skos:prefLabel>
    <skos:definition xml:lang="en">A person in whom the taints and the remaining fetters have ended. Nothing further is to be done for their own freedom.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">arahant</skos:altLabel>
    <skos:altLabel xml:lang="en">worthy one</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#asava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimutti"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#nibbana">
    <skos:prefLabel xml:lang="pi">nibbāna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">extinguishing</skos:prefLabel>
    <skos:definition xml:lang="en">The end of greed, hatred, and delusion, and so the end of the fire of dukkha. It is not a place and not a self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">nibanna</skos:altLabel>
    <skos:altLabel xml:lang="en">nirvana</skos:altLabel>
    <skos:altLabel xml:lang="en">extinguishing</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nirodha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#arahant"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimutti"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vimutti">
    <skos:prefLabel xml:lang="pi">vimutti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">liberation</skos:prefLabel>
    <skos:definition xml:lang="en">Release. The mind is freed from what bound it, for a time through collectedness or for good through the end of the taints.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">liberation</skos:altLabel>
    <skos:altLabel xml:lang="en">release</skos:altLabel>
    <skos:altLabel xml:lang="en">freedom</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#cetovimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pannavimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimokkha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#magga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#cetovimutti">
    <skos:prefLabel xml:lang="pi">cetovimutti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">liberation of the mind</skos:prefLabel>
    <skos:definition xml:lang="en">A mind released, often through collectedness, from hindrance or from defilement. The discourses pair it with liberation by wisdom.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">liberation of the mind</skos:altLabel>
    <skos:altLabel xml:lang="en">release of mind</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pannavimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#pannavimutti">
    <skos:prefLabel xml:lang="pi">paññāvimutti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">liberation by wisdom</skos:prefLabel>
    <skos:definition xml:lang="en">Release that comes from seeing. It is the understanding side of freedom, named beside liberation of the mind.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">liberation by wisdom</skos:altLabel>
    <skos:altLabel xml:lang="en">release by understanding</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#cetovimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vimokkha">
    <skos:prefLabel xml:lang="pi">aṭṭha vimokkhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">eight deliverances</skos:prefLabel>
    <skos:definition xml:lang="en">Eight ways the mind is released from being stuck on form and on feeling, ending with the cessation of perception and feeling.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-noble-persons"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">eight deliverances</skos:altLabel>
    <skos:altLabel xml:lang="en">deliverances</skos:altLabel>
    <skos:altLabel xml:lang="en">vimokkha</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimutti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#paramattha">
    <skos:prefLabel xml:lang="pi">paramattha dhammā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultimate realities</skos:prefLabel>
    <skos:definition xml:lang="en">The Theravada Abhidhamma division of what is finally real for analysis: consciousness, mental factors, form, and nibbāna. This is a later map laid over the sutta teachings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-ultimates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">ultimate realities</skos:altLabel>
    <skos:altLabel xml:lang="en">abhidhamma</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#citta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#cetasika"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#rupa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#citta">
    <skos:prefLabel xml:lang="pi">citta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mind</skos:prefLabel>
    <skos:definition xml:lang="en">The knowing moment itself. In mindfulness of mind, one knows its quality without owning it.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-ultimates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">citta</skos:altLabel>
    <skos:altLabel xml:lang="en">heart-mind</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#cittanupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vinnana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#cetasika">
    <skos:prefLabel xml:lang="pi">cetasika</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mental factors</skos:prefLabel>
    <skos:definition xml:lang="en">Qualities that arise with a moment of knowing, such as contact, feeling, perception, intention, and the roots.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-ultimates"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mental factors</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#citta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sankhara"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kamma">
    <skos:prefLabel xml:lang="pi">kamma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">action</skos:prefLabel>
    <skos:definition xml:lang="en">Intentional action of body, speech, or mind, and the way that intention shapes what follows.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">karma</skos:altLabel>
    <skos:altLabel xml:lang="en">kamma</skos:altLabel>
    <skos:altLabel xml:lang="en">action</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vipaka"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sankhara"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vipaka">
    <skos:prefLabel xml:lang="pi">vipāka</skos:prefLabel>
    <skos:prefLabel xml:lang="en">result</skos:prefLabel>
    <skos:definition xml:lang="en">The ripening of intentional action as experience. Result is to be understood, not hated or owned.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">result</skos:altLabel>
    <skos:altLabel xml:lang="en">fruition</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamma"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#samsara">
    <skos:prefLabel xml:lang="pi">saṃsāra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wandering on</skos:prefLabel>
    <skos:definition xml:lang="en">The round of birth, aging, and death kept spinning by not-knowing and craving.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">samsara</skos:altLabel>
    <skos:altLabel xml:lang="en">wandering on</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#paticcasamuppada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#yathabhuta">
    <skos:prefLabel xml:lang="pi">yathābhūta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">as it actually is</skos:prefLabel>
    <skos:definition xml:lang="en">Knowing a thing in the way it is, rather than in the way wanting or fear paints it.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">according to reality</skos:altLabel>
    <skos:altLabel xml:lang="en">as it really is</skos:altLabel>
    <skos:altLabel xml:lang="en">yathabhuta</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#yathabhutananadassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vipassana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#nanadassana">
    <skos:prefLabel xml:lang="pi">ñāṇadassana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">knowledge and vision</skos:prefLabel>
    <skos:definition xml:lang="en">Seeing that has become understanding. In the discourses it names a direct knowing, not a borrowed opinion.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">knowledge and vision</skos:altLabel>
    <skos:altLabel xml:lang="en">knowing and seeing</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#yathabhutananadassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#yathabhutananadassana">
    <skos:prefLabel xml:lang="pi">yathābhūtañāṇadassana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">knowledge and vision according to reality</skos:prefLabel>
    <skos:definition xml:lang="en">Knowledge and vision of things as they actually are. Insight is aimed at this seeing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">knowledge and vision of things as they are</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#yathabhuta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nanadassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bodhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vipassana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vipassana">
    <skos:prefLabel xml:lang="pi">vipassanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">insight</skos:prefLabel>
    <skos:definition xml:lang="en">Clear seeing of the three marks in present experience. It is a quality of attention, not a brand of technique.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">insight</skos:altLabel>
    <skos:altLabel xml:lang="en">vipassana</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samatha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tilakkhana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#samatha">
    <skos:prefLabel xml:lang="pi">samatha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calming</skos:prefLabel>
    <skos:definition xml:lang="en">The cultivation of a peaceful, gathered mind. It supports insight and is not a rival to it.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">calm</skos:altLabel>
    <skos:altLabel xml:lang="en">tranquility meditation</skos:altLabel>
    <skos:altLabel xml:lang="en">samatha</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vipassana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bhavana">
    <skos:prefLabel xml:lang="pi">bhāvanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cultivation</skos:prefLabel>
    <skos:definition xml:lang="en">Developing wholesome qualities by bringing them to mind again and again. Meditation is one form of it.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">cultivation</skos:altLabel>
    <skos:altLabel xml:lang="en">meditation</skos:altLabel>
    <skos:altLabel xml:lang="en">bhavana</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samatha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vipassana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#yoniso">
    <skos:prefLabel xml:lang="pi">yoniso manasikāra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wise attention</skos:prefLabel>
    <skos:definition xml:lang="en">Attending to the root of an experience: what feeds it, and what leads toward freedom rather than toward more clinging.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">wise attention</skos:altLabel>
    <skos:altLabel xml:lang="en">appropriate attention</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#appamada">
    <skos:prefLabel xml:lang="pi">appamāda</skos:prefLabel>
    <skos:prefLabel xml:lang="en">heedfulness</skos:prefLabel>
    <skos:definition xml:lang="en">Care that does not throw life away. The canon treats it as the one condition for all wholesome states.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">heedfulness</skos:altLabel>
    <skos:altLabel xml:lang="en">diligence</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viriya"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dana">
    <skos:prefLabel xml:lang="pi">dāna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">generosity</skos:prefLabel>
    <skos:definition xml:lang="en">Giving. It loosens holding and is the natural companion of a teaching offered freely.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">generosity</skos:altLabel>
    <skos:altLabel xml:lang="en">giving</skos:altLabel>
    <skos:altLabel xml:lang="en">dana</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sila"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sunnata">
    <skos:prefLabel xml:lang="pi">suññatā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">emptiness</skos:prefLabel>
    <skos:definition xml:lang="en">In the early texts, emptiness of a self in experience. Later traditions unfold this word much further; here it stays tied to anattā.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-practice"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">emptiness</skos:altLabel>
    <skos:altLabel xml:lang="en">sunyata</skos:altLabel>
    <skos:altLabel xml:lang="en">sunnata</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anatta"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#tisarana">
    <skos:prefLabel xml:lang="pi">tisaraṇa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three refuges</skos:prefLabel>
    <skos:definition xml:lang="en">Going for refuge to the Buddha, the Dhamma, and the Saṅgha: the teacher, the teaching, and the community of those who have practiced it deeply.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-refuge"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">three refuges</skos:altLabel>
    <skos:altLabel xml:lang="en">refuge</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#buddha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dhamma"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sangha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#buddha">
    <skos:prefLabel xml:lang="pi">buddha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">awakened one</skos:prefLabel>
    <skos:definition xml:lang="en">One who has woken up to the way things are, and the historical teacher Gotama whose teaching this ontology records.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-refuge"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">buddha</skos:altLabel>
    <skos:altLabel xml:lang="en">awakened</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tisarana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bodhi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dhamma">
    <skos:prefLabel xml:lang="pi">dhamma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">the teaching, a phenomenon</skos:prefLabel>
    <skos:definition xml:lang="en">Two related uses: the teaching that leads to freedom, and any phenomenon that can be known. The mind's objects are dhammas in the second sense.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-refuge"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">dharma</skos:altLabel>
    <skos:altLabel xml:lang="en">dhamma</skos:altLabel>
    <skos:altLabel xml:lang="en">the teaching</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tisarana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dhammanupassana"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-traditions"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sangha">
    <skos:prefLabel xml:lang="pi">saṅgha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">community</skos:prefLabel>
    <skos:definition xml:lang="en">The community of practitioners, and in the refuge formula especially those who have entered the noble path.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-refuge"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">sangha</skos:altLabel>
    <skos:altLabel xml:lang="en">community</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tisarana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sotapanna"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-traditions"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bodhi">
    <skos:prefLabel xml:lang="pi">bodhi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">awakening</skos:prefLabel>
    <skos:definition xml:lang="en">Waking up. The factors that assist it are the bodhipakkhiyā dhammā.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-refuge"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">awakening</skos:altLabel>
    <skos:altLabel xml:lang="en">enlightenment</skos:altLabel>
    <skos:altLabel xml:lang="en">bodhi</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#buddha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bodhipakkhiya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nibbana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#yathabhutananadassana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
</rdf:RDF>
