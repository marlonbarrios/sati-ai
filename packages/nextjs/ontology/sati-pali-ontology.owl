  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kayanupassana">
    <skos:prefLabel xml:lang="pi">kāyānupassanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contemplation of the body</skos:prefLabel>
    <skos:definition xml:lang="en">Attending to the body as body: breath, postures, activities, parts, and elements, without turning it into a self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mindfulness of the body</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#satipatthana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#rupa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#iriyapatha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#patikulamanasikara"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dhatu"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sivathika"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-practice-guide"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#iriyapatha">
    <skos:prefLabel xml:lang="pi">iriyāpatha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">postures</skos:prefLabel>
    <skos:definition xml:lang="en">The four ways the body is disposed: walking, standing, sitting, and lying down. Mindfulness knows which one is happening.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">four postures</skos:altLabel>
    <skos:altLabel xml:lang="en">postures</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sampajanna"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#patikulamanasikara">
    <skos:prefLabel xml:lang="pi">paṭikūlamanasikāra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">attention to the body's parts</skos:prefLabel>
    <skos:definition xml:lang="en">Looking at the body as a collection of parts, as the Satipaṭṭhāna Sutta lists them, so that it is harder to take the body as a polished self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">body parts</skos:altLabel>
    <skos:altLabel xml:lang="en">unattractiveness</skos:altLabel>
    <skos:altLabel xml:lang="en">asubha</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#rupa"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dhatu">
    <skos:prefLabel xml:lang="pi">dhātu</skos:prefLabel>
    <skos:prefLabel xml:lang="en">elements</skos:prefLabel>
    <skos:definition xml:lang="en">In mindfulness of the body, earth, water, fire, and air: solidity, cohesion, warmth, and motion, known as qualities rather than as mine.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">elements</skos:altLabel>
    <skos:altLabel xml:lang="en">four elements</skos:altLabel>
    <skos:altLabel xml:lang="en">mahabhuta</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#rupa"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sivathika">
    <skos:prefLabel xml:lang="pi">sivathikā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cemetery contemplation</skos:prefLabel>
    <skos:definition xml:lang="en">Remembering a corpse in its stages of decay, and seeing that this body has the same nature. It is a contemplation of impermanence, not a fascination with death.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">cemetery contemplations</skos:altLabel>
    <skos:altLabel xml:lang="en">charnel ground</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anicca"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vedananupassana">
    <skos:prefLabel xml:lang="pi">vedanānupassanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contemplation of feeling</skos:prefLabel>
    <skos:definition xml:lang="en">Knowing a feeling as pleasant, painful, or neutral, worldly or unworldly, as it is.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mindfulness of feeling</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vedana"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-practice-guide"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#cittanupassana">
    <skos:prefLabel xml:lang="pi">cittānupassanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contemplation of mind</skos:prefLabel>
    <skos:definition xml:lang="en">Knowing the mind's current color: with or without greed, hatred, or delusion; contracted or spacious; concentrated or not.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mindfulness of mind</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#citta"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-practice-guide"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dhammanupassana">
    <skos:prefLabel xml:lang="pi">dhammānupassanā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contemplation of patterns</skos:prefLabel>
    <skos:definition xml:lang="en">Watching the categories of experience themselves: hindrances, aggregates, sense bases, factors of awakening, and the truths.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mindfulness of dhammas</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#satipatthana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nivarana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-practice-guide"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bodhipakkhiya">
    <skos:prefLabel xml:lang="pi">bodhipakkhiyā dhammā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">thirty-seven factors of awakening</skos:prefLabel>
    <skos:definition xml:lang="en">The classical map of the path: four foundations of mindfulness, four right efforts, four bases of success, five faculties, five powers, seven awakening factors, and the eightfold path.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">thirty-seven factors</skos:altLabel>
    <skos:altLabel xml:lang="en">factors of awakening</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#satipatthana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammappadhana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#iddhipada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#indriya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#atthangikamagga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sammappadhana">
    <skos:prefLabel xml:lang="pi">cattāro sammappadhānā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">four right efforts</skos:prefLabel>
    <skos:definition xml:lang="en">Effort to prevent and abandon the unwholesome, and to arouse and maintain the wholesome.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">four right efforts</skos:altLabel>
    <skos:altLabel xml:lang="en">right effort</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammavayama"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viriya"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#iddhipada">
    <skos:prefLabel xml:lang="pi">cattāro iddhipādā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">four bases of success</skos:prefLabel>
    <skos:definition xml:lang="en">Desire to act, energy, mind, and investigation, each joined with effort, so that practice actually develops.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">bases of success</skos:altLabel>
    <skos:altLabel xml:lang="en">bases of power</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#chanda"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viriya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimamsa"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#chanda">
    <skos:prefLabel xml:lang="pi">chanda</skos:prefLabel>
    <skos:prefLabel xml:lang="en">desire to act</skos:prefLabel>
    <skos:definition xml:lang="en">Wholesome interest in doing what is needed. It is not the same as sensual craving.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">zeal</skos:altLabel>
    <skos:altLabel xml:lang="en">desire to act</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#iddhipada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#tanha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vimamsa">
    <skos:prefLabel xml:lang="pi">vīmaṃsā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">investigation</skos:prefLabel>
    <skos:definition xml:lang="en">Looking into how a state actually works, rather than taking it on habit.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">investigation</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#iddhipada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dhammavicaya"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#indriya">
    <skos:prefLabel xml:lang="pi">pañcindriyāni</skos:prefLabel>
    <skos:prefLabel xml:lang="en">five faculties</skos:prefLabel>
    <skos:definition xml:lang="en">Faith, energy, mindfulness, collectedness, and wisdom as governing faculties. As powers, the same five are unshakable.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">five faculties</skos:altLabel>
    <skos:altLabel xml:lang="en">five powers</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#saddha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viriya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#panna"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#saddha">
    <skos:prefLabel xml:lang="pi">saddhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">confidence</skos:prefLabel>
    <skos:definition xml:lang="en">Trust that leans toward practice, born of understanding rather than blind belief.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">faith</skos:altLabel>
    <skos:altLabel xml:lang="en">confidence</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#indriya"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bojjhanga">
    <skos:prefLabel xml:lang="pi">satta bojjhaṅgā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">seven awakening factors</skos:prefLabel>
    <skos:definition xml:lang="en">Mindfulness, investigation, energy, joy, tranquility, collectedness, and equipoise. Mindfulness starts the set and keeps it balanced.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">seven factors of awakening</skos:altLabel>
    <skos:altLabel xml:lang="en">awakening factors</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sati"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dhammavicaya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viriya"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#piti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#passaddhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#upekkha"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dhammavicaya">
    <skos:prefLabel xml:lang="pi">dhammavicaya</skos:prefLabel>
    <skos:prefLabel xml:lang="en">investigation of experience</skos:prefLabel>
    <skos:definition xml:lang="en">The awakening factor that looks into mental and bodily events and sorts what leads toward freedom.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">investigation of dhammas</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimamsa"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#viriya">
    <skos:prefLabel xml:lang="pi">vīriya</skos:prefLabel>
    <skos:prefLabel xml:lang="en">energy</skos:prefLabel>
    <skos:definition xml:lang="en">Sustained effort that is neither collapse nor strain.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">energy</skos:altLabel>
    <skos:altLabel xml:lang="en">effort</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sammavayama"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#piti">
    <skos:prefLabel xml:lang="pi">pīti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">joy</skos:prefLabel>
    <skos:definition xml:lang="en">Interested, buoyant joy that refreshes practice. It is stronger and more energetic than quiet happiness.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">joy</skos:altLabel>
    <skos:altLabel xml:lang="en">rapture</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sukha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sukha">
    <skos:prefLabel xml:lang="pi">sukha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">happiness</skos:prefLabel>
    <skos:definition xml:lang="en">The pleasant ease that can follow joy when effort softens. It is a feeling tone, and still impermanent.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">happiness</skos:altLabel>
    <skos:altLabel xml:lang="en">ease</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#piti"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vedana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#passaddhi">
    <skos:prefLabel xml:lang="pi">passaddhi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tranquility</skos:prefLabel>
    <skos:definition xml:lang="en">Calm of body and mind. A factor of awakening, and the quiet that lets collectedness deepen.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-thirty-seven-factors"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">tranquility</skos:altLabel>
    <skos:altLabel xml:lang="en">calm</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bojjhanga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samadhi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#nivarana">
    <skos:prefLabel xml:lang="pi">pañca nīvaraṇāni</skos:prefLabel>
    <skos:prefLabel xml:lang="en">five hindrances</skos:prefLabel>
    <skos:definition xml:lang="en">Sensual desire, ill will, dullness, restlessness-and-worry, and doubt. They cover the mind so that it cannot see clearly.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">five hindrances</skos:altLabel>
    <skos:altLabel xml:lang="en">hindrances</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamacchanda"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#byapada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#thinamiddha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#uddhaccakukkucca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vicikiccha"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-analayo-direct-path"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kamacchanda">
    <skos:prefLabel xml:lang="pi">kāmacchanda</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sensual desire</skos:prefLabel>
    <skos:definition xml:lang="en">The hindrance of wanting to pull a pleasant sense experience closer.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">sensual desire</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nivarana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamaraga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#byapada">
    <skos:prefLabel xml:lang="pi">byāpāda</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ill will</skos:prefLabel>
    <skos:definition xml:lang="en">The hindrance of pushing away: irritation, hostility, and the wish that something be harmed or gone.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">ill will</skos:altLabel>
    <skos:altLabel xml:lang="en">ill-will</skos:altLabel>
    <skos:altLabel xml:lang="en">vyāpāda</skos:altLabel>
    <skos:altLabel xml:lang="en">vyapada</skos:altLabel>
    <skos:altLabel xml:lang="en">aversion</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dosa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nivarana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#thinamiddha">
    <skos:prefLabel xml:lang="pi">thīnamiddha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sloth and torpor</skos:prefLabel>
    <skos:definition xml:lang="en">Heaviness of mind and body that sinks attention.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">sloth-and-torpor</skos:altLabel>
    <skos:altLabel xml:lang="en">sloth</skos:altLabel>
    <skos:altLabel xml:lang="en">torpor</skos:altLabel>
    <skos:altLabel xml:lang="en">dullness</skos:altLabel>
    <skos:altLabel xml:lang="en">sleepiness</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nivarana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#uddhaccakukkucca">
    <skos:prefLabel xml:lang="pi">uddhaccakukkucca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restlessness and worry</skos:prefLabel>
    <skos:definition xml:lang="en">A stirred mind, plus regret that keeps rehearsing what was done or left undone.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">restless-and-worry</skos:altLabel>
    <skos:altLabel xml:lang="en">restlessness-and-worry</skos:altLabel>
    <skos:altLabel xml:lang="en">restlessness</skos:altLabel>
    <skos:altLabel xml:lang="en">worry</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#uddhacca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kukkucca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nivarana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kukkucca">
    <skos:prefLabel xml:lang="pi">kukkucca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">worry</skos:prefLabel>
    <skos:definition xml:lang="en">Remorse about what was done or left undone. Together with restlessness it is one of the five hindrances.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">worry</skos:altLabel>
    <skos:altLabel xml:lang="en">remorse</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#uddhacca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#uddhaccakukkucca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#vicikiccha">
    <skos:prefLabel xml:lang="pi">vicikicchā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">doubt</skos:prefLabel>
    <skos:definition xml:lang="en">Paralyzing uncertainty about the practice, not healthy questioning. It is both a hindrance and an early fetter.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-hindrances"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">doubt</skos:altLabel>
    <skos:altLabel xml:lang="en">skeptical doubt</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nivarana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samyojana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimamsa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dhammavicaya"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#samyojana">
    <skos:prefLabel xml:lang="pi">dasa saṃyojanāni</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ten fetters</skos:prefLabel>
    <skos:definition xml:lang="en">What binds a person to the round: identity view, doubt, attachment to rites, sensual lust, aversion, lust for form and the formless, conceit, restlessness, and not-knowing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">ten fetters</skos:altLabel>
    <skos:altLabel xml:lang="en">fetters</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sakkayaditthi"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#silabbataparamasa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamaraga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#patigha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#mana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#uddhacca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#avijja"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#sakkayaditthi">
    <skos:prefLabel xml:lang="pi">sakkāyadiṭṭhi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">identity view</skos:prefLabel>
    <skos:definition xml:lang="en">Taking one of the aggregates, or the set of them, to be a self.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">identity view</skos:altLabel>
    <skos:altLabel xml:lang="en">personality view</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#anatta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#pancakkhandha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#silabbataparamasa">
    <skos:prefLabel xml:lang="pi">sīlabbataparāmāsa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">attachment to rites and vows</skos:prefLabel>
    <skos:definition xml:lang="en">Clinging to a rule or ritual as if performing it were itself awakening.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">attachment to rites</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samyojana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#upadana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kamaraga">
    <skos:prefLabel xml:lang="pi">kāmarāga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sensual lust</skos:prefLabel>
    <skos:definition xml:lang="en">The fetter of desire for sensual pleasure. It thins at the once-return and falls away at non-return.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">sensual lust</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamacchanda"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#raga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#patigha">
    <skos:prefLabel xml:lang="pi">paṭigha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aversion</skos:prefLabel>
    <skos:definition xml:lang="en">The fetter of resistance and ill will. It is abandoned with the stage of non-return.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">aversion</skos:altLabel>
    <skos:altLabel xml:lang="en">repulsion</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#byapada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dosa"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#mana">
    <skos:prefLabel xml:lang="pi">māna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conceit</skos:prefLabel>
    <skos:definition xml:lang="en">The comparison 'I am better, worse, or equal.' It can remain subtly even after gross identity view has fallen.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">conceit</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#samyojana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#arahant"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#uddhacca">
    <skos:prefLabel xml:lang="pi">uddhacca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restlessness</skos:prefLabel>
    <skos:definition xml:lang="en">The subtle stir of the mind. As a fetter it is only fully dropped at arahantship.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-fetters"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">restlessness</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#uddhaccakukkucca"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kukkucca"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#asava">
    <skos:prefLabel xml:lang="pi">āsavā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">taints</skos:prefLabel>
    <skos:definition xml:lang="en">Outflows that intoxicate the mind: sensuality, becoming, views, and not-knowing. An arahant is one in whom they have ended.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">taints</skos:altLabel>
    <skos:altLabel xml:lang="en">outflows</skos:altLabel>
    <skos:altLabel xml:lang="en">asavas</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamasava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bhavasava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#ditthasava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#avijja"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kamasava">
    <skos:prefLabel xml:lang="pi">kāmāsava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">taint of sensuality</skos:prefLabel>
    <skos:definition xml:lang="en">The outflow of intoxication with sensual pleasure.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">taint of sensuality</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#asava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kamaraga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#bhavasava">
    <skos:prefLabel xml:lang="pi">bhavāsava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">taint of becoming</skos:prefLabel>
    <skos:definition xml:lang="en">The outflow of wanting to continue as a particular kind of being.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">taint of becoming</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#bhava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#asava"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#ditthasava">
    <skos:prefLabel xml:lang="pi">diṭṭhāsava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">taint of views</skos:prefLabel>
    <skos:definition xml:lang="en">The outflow of clinging to a view as if the view were the one who sees.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">taint of views</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#asava"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#sakkayaditthi"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#raga">
    <skos:prefLabel xml:lang="pi">rāga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">passion</skos:prefLabel>
    <skos:definition xml:lang="en">The root that pulls toward. With hatred and delusion it is one of the three unwholesome roots. Dispassion is its fading.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">passion</skos:altLabel>
    <skos:altLabel xml:lang="en">greed</skos:altLabel>
    <skos:altLabel xml:lang="en">lust</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#viraga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#dosa"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#moha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#lobha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#viraga">
    <skos:prefLabel xml:lang="pi">virāga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dispassion</skos:prefLabel>
    <skos:definition xml:lang="en">The fading of passion. In the discourses it stands between clear seeing and the full end of craving.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">dispassion</skos:altLabel>
    <skos:altLabel xml:lang="en">fading of lust</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#raga"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#nirodha"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#vimutti"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#lobha">
    <skos:prefLabel xml:lang="pi">lobha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">greed</skos:prefLabel>
    <skos:definition xml:lang="en">The Abhidhamma name for the same pulling root more often called rāga in the suttas.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">lobha</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#raga"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#dosa">
    <skos:prefLabel xml:lang="pi">dosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hatred</skos:prefLabel>
    <skos:definition xml:lang="en">The root that strikes out or pushes away.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">hatred</skos:altLabel>
    <skos:altLabel xml:lang="en">anger</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#byapada"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#patigha"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#moha">
    <skos:prefLabel xml:lang="pi">moha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">delusion</skos:prefLabel>
    <skos:definition xml:lang="en">The root of not seeing. It is the cloudy side of avijjā.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-taints-and-roots"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">delusion</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#avijja"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#brahmavihara">
    <skos:prefLabel xml:lang="pi">brahmavihārā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">divine abidings</skos:prefLabel>
    <skos:definition xml:lang="en">Four boundless attitudes: goodwill, compassion, joy in others' good, and equanimity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-divine-abidings"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">divine abidings</skos:altLabel>
    <skos:altLabel xml:lang="en">brahmaviharas</skos:altLabel>
    <skos:altLabel xml:lang="en">four immeasurables</skos:altLabel>
