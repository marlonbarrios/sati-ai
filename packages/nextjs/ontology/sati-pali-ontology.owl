  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#jivha">
    <skos:prefLabel xml:lang="pi">jivhā</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tongue</skos:prefLabel>
    <skos:definition xml:lang="en">The tongue base, the door of taste.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">tongue</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#kaya">
    <skos:prefLabel xml:lang="pi">kāya</skos:prefLabel>
    <skos:prefLabel xml:lang="en">body</skos:prefLabel>
    <skos:definition xml:lang="en">The body as the door of touch, and also the whole lived body contemplated in mindfulness of the body.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">body</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#kayanupassana"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <dct:source rdf:resource="https://marlonbarrios.github.io/sati-ontology#source-varela-science-religion-art"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
  <owl:Class rdf:about="https://marlonbarrios.github.io/sati-ontology#mano">
    <skos:prefLabel xml:lang="pi">mano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mind</skos:prefLabel>
    <skos:definition xml:lang="en">The mind base. Its objects are dhammas: ideas, memories, images, and mental qualities.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://marlonbarrios.github.io/sati-ontology#group-sense-bases"/>
    <skos:inScheme rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
    <skos:altLabel xml:lang="en">mind base</skos:altLabel>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#citta"/>
    <skos:related rdf:resource="https://marlonbarrios.github.io/sati-ontology#salayatana"/>
    <rdfs:isDefinedBy rdf:resource="https://marlonbarrios.github.io/sati-ontology"/>
  </owl:Class>
