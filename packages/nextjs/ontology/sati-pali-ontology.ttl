  skos:prefLabel "bhāvanā"@pi ;
  skos:prefLabel "cultivation"@en ;
  skos:definition "Developing wholesome qualities by bringing them to mind again and again. Meditation is one form of it."@en ;
  skos:altLabel "cultivation"@en ;
  skos:altLabel "meditation"@en ;
  skos:altLabel "bhavana"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#samatha> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#vipassana> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#yoniso> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-practice> ;
  skos:prefLabel "yoniso manasikāra"@pi ;
  skos:prefLabel "wise attention"@en ;
  skos:definition "Attending to the root of an experience: what feeds it, and what leads toward freedom rather than toward more clinging."@en ;
  skos:altLabel "wise attention"@en ;
  skos:altLabel "appropriate attention"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#sati> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#panna> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#appamada> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-practice> ;
  skos:prefLabel "appamāda"@pi ;
  skos:prefLabel "heedfulness"@en ;
  skos:definition "Care that does not throw life away. The canon treats it as the one condition for all wholesome states."@en ;
  skos:altLabel "heedfulness"@en ;
  skos:altLabel "diligence"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#sati> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#viriya> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#dana> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-practice> ;
  skos:prefLabel "dāna"@pi ;
  skos:prefLabel "generosity"@en ;
  skos:definition "Giving. It loosens holding and is the natural companion of a teaching offered freely."@en ;
  skos:altLabel "generosity"@en ;
  skos:altLabel "giving"@en ;
  skos:altLabel "dana"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#sila> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#sunnata> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-practice> ;
  skos:prefLabel "suññatā"@pi ;
  skos:prefLabel "emptiness"@en ;
  skos:definition "In the early texts, emptiness of a self in experience. Later traditions unfold this word much further; here it stays tied to anattā."@en ;
  skos:altLabel "emptiness"@en ;
  skos:altLabel "sunyata"@en ;
  skos:altLabel "sunnata"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#anatta> ;
  dct:source <https://marlonbarrios.github.io/sati-ontology#source-analayo-compassion> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#tisarana> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-refuge> ;
  skos:prefLabel "tisaraṇa"@pi ;
  skos:prefLabel "three refuges"@en ;
  skos:definition "Going for refuge to the Buddha, the Dhamma, and the Saṅgha: the teacher, the teaching, and the community of those who have practiced it deeply."@en ;
  skos:altLabel "three refuges"@en ;
  skos:altLabel "refuge"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#buddha> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#dhamma> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#sangha> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#buddha> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-refuge> ;
  skos:prefLabel "buddha"@pi ;
  skos:prefLabel "awakened one"@en ;
  skos:definition "One who has woken up to the way things are, and the historical teacher Gotama whose teaching this ontology records."@en ;
  skos:altLabel "buddha"@en ;
  skos:altLabel "awakened"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#tisarana> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#bodhi> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#dhamma> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-refuge> ;
  skos:prefLabel "dhamma"@pi ;
  skos:prefLabel "the teaching, a phenomenon"@en ;
  skos:definition "Two related uses: the teaching that leads to freedom, and any phenomenon that can be known. The mind's objects are dhammas in the second sense."@en ;
  skos:altLabel "dharma"@en ;
  skos:altLabel "dhamma"@en ;
  skos:altLabel "the teaching"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#tisarana> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#dhammanupassana> ;
  dct:source <https://marlonbarrios.github.io/sati-ontology#source-analayo-traditions> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#sangha> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-refuge> ;
  skos:prefLabel "saṅgha"@pi ;
  skos:prefLabel "community"@en ;
  skos:definition "The community of practitioners, and in the refuge formula especially those who have entered the noble path."@en ;
  skos:altLabel "sangha"@en ;
  skos:altLabel "community"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#tisarana> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#sotapanna> ;
  dct:source <https://marlonbarrios.github.io/sati-ontology#source-analayo-traditions> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .

<https://marlonbarrios.github.io/sati-ontology#bodhi> a owl:Class, skos:Concept ;
  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-refuge> ;
  skos:prefLabel "bodhi"@pi ;
  skos:prefLabel "awakening"@en ;
  skos:definition "Waking up. The factors that assist it are the bodhipakkhiyā dhammā."@en ;
  skos:altLabel "awakening"@en ;
  skos:altLabel "enlightenment"@en ;
  skos:altLabel "bodhi"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#buddha> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#bodhipakkhiya> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#nibbana> ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#yathabhutananadassana> ;
  rdfs:isDefinedBy <https://marlonbarrios.github.io/sati-ontology> .
