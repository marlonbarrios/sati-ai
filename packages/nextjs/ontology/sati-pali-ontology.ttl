  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness> ;
  skos:prefLabel "paṭikūlamanasikāra"@pi ;
  skos:prefLabel "attention to the body's parts"@en ;
  skos:definition "Looking at the body as a collection of parts, as the Satipaṭṭhāna Sutta lists them, so that it is harder to take the body as a polished self."@en ;
  skos:altLabel "body parts"@en ;
  skos:altLabel "unattractiveness"@en ;
  skos:altLabel "asubha"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#kayanupassana> ;
