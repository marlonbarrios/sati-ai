  skos:inScheme <https://marlonbarrios.github.io/sati-ontology> ;
  rdfs:subClassOf <https://marlonbarrios.github.io/sati-ontology#group-foundations-of-mindfulness> ;
  skos:prefLabel "sivathikā"@pi ;
  skos:prefLabel "cemetery contemplation"@en ;
