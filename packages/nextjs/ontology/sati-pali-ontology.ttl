  skos:prefLabel "paṭiccasamuppāda"@pi ;
  skos:prefLabel "dependent origination"@en ;
  skos:definition "Nothing arises alone. From not-knowing through feeling, craving, clinging, and becoming, birth and aging-and-death keep turning. When a link is no longer fed, the pattern can cease."@en ;
  skos:altLabel "dependent origination"@en ;
  skos:altLabel "dependent arising"@en ;
  skos:related <https://marlonbarrios.github.io/sati-ontology#avijja> ;
